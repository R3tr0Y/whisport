# ==== 目标板（对齐官方基线：ESP32-C3 / 8MB / 无 PSRAM / IDF 5.5.3）====
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ==== 分区（whisport 双 OTA 布局，决策 D11；官方门禁允许自定义）====
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ==== 控制台（官方基线约定：USB-Serial-JTAG，GPIO18/19）====
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ==== LVGL（随官方 BSP：9.5，16bit 色深）====
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_MEM_SIZE=24576

# ==== 系统 ====
CONFIG_FREERTOS_HZ=1000

# ==== 体积优化（8MB flash 预算，决策 D11）====
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# ==== TLS（HTTPS 客户端；可换自定义 Cloudflare 根 CA 省 ~40KB，见 README）====
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# 无 PSRAM：压缩 TLS 缓冲（规划 §7.3）
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4KB
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4KB

# ==== BLE 关闭（本期不用；官方 demo 的 NimBLE 配置不引入）====
CONFIG_BT_ENABLED=n

# Wi-Fi（NVS 保存校准）
CONFIG_ESP_WIFI_NVS_ENABLED=y
